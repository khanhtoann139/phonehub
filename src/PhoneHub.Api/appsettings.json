{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "mysql",
    "InitializeOnStartup": true
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "phonehub",
    "Audience": "phonehub-web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Auth": {
    "CookieSecure": true
  },
  "Shop": {
    "FreeShippingThreshold": 2000000,
    "ShippingFee": 30000,
    "MaxQuantityPerItem": 5,
    "FrontendUrl": "http://localhost:5173",
    "CorsOrigins": [ "http://localhost:5173" ]
  },
  "Payments": {
    "Providers": [ "cod", "sandbox" ],
    "PublicApiUrl": "http://localhost:5080",
    "PendingTimeoutMinutes": 30,
    "Sandbox": { "Secret": "" },
    "VnPay": { "TmnCode": "", "HashSecret": "", "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html" }
  },
  "RateLimit": {
    "GlobalPerMinute": 300,
    "AuthPerMinute": 10,
    "WritePerMinute": 30
  },
  "Seed": {
    "Enabled": true,
    "DemoOrders": true,
    "AdminEmail": "admin@phonehub.local",
    "AdminPassword": "",
    "CustomerEmail": "khachhang@phonehub.local",
    "CustomerPassword": ""
  }
}
